# 부팅 시 자동 실행 서비스
#   sudo cp systemd/aiframe.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now aiframe
# (User / WorkingDirectory 경로는 각자 환경에 맞게 수정)
[Unit]
Description=Semosemo AI E-Paper Frame
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/2026Semosemo
ExecStart=/home/pi/2026Semosemo/.venv/bin/python -m aiframe
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
